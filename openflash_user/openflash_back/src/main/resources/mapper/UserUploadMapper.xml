<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="openflash_core.mapper.UserUploadMapper">

    <insert id="insert">
        INSERT INTO pw_user_upload (user_id, relative_path)
        VALUES (#{userId}, #{relativePath})
    </insert>

    <select id="lockOwnerIdByPath" resultType="long">
        SELECT user_id FROM pw_user_upload
        WHERE relative_path = #{relativePath}
        FOR UPDATE
    </select>

    <select id="findPathsByUserId" resultType="string">
        SELECT relative_path FROM pw_user_upload
        WHERE user_id = #{userId} ORDER BY relative_path COLLATE "C"
    </select>

    <delete id="deleteByUserId">
        DELETE FROM pw_user_upload WHERE user_id = #{userId}
    </delete>

</mapper>
