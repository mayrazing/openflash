<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="openflash_core.mapper.PlatformAiUserAccessMapper">
    <select id="findOverride" resultType="java.lang.Boolean">
        SELECT enabled FROM pw_platform_ai_user_access
        WHERE user_id = #{userId} AND offering_id = #{offeringId}
        LIMIT 1
    </select>
</mapper>
